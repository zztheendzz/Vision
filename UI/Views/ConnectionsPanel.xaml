<UserControl x:Class="UI.Views.ConnectionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Views"
             xmlns:views="clr-namespace:UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="{StaticResource VsWindowBrush}">
            <DockPanel>

                <!-- Thanh công cụ -->
                <Border DockPanel.Dock="Top" Background="{StaticResource VsPanelHeaderBrush}"
                    BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Kết nối tất cả" Command="{Binding Devices.ConnectAllCommand}" />
                        <Button Content="Ngắt tất cả" Command="{Binding Devices.DisconnectAllCommand}" />
                        <Rectangle Width="1" Fill="{StaticResource VsBorderBrush}" Margin="6,2" />
                        <Button Content="Cấu hình thiết bị..." Click="OpenConfig_Click" />
                    </StackPanel>
                </Border>

                <!-- Mỗi thiết bị trong danh sách là một thẻ. Thêm thiết bị ở cửa sổ cấu hình thì thẻ mới tự xuất hiện. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Devices.Devices}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Margin="6" Padding="10" CornerRadius="3"
                                    Background="{StaticResource VsPanelBrush}"
                                    BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="10" Height="10"
                                                 Fill="{StaticResource VsMutedBrush}" Margin="0,0,8,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TypeName}"
                                                   Foreground="{StaticResource VsMutedBrush}" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <TextBlock Margin="18,4,0,0" Foreground="{StaticResource VsMutedBrush}" Text="{Binding Summary}" />
                                        <TextBlock Text="{Binding StatusText}" Margin="18,2,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Kết nối" Style="{StaticResource AccentButton}"
                                                Command="{Binding ConnectCommand}" />
                                            <Button Content="Ngắt" Style="{StaticResource OutlineButton}"
                                                Command="{Binding DisconnectCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource VsOkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
