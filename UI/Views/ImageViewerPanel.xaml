<UserControl x:Class="UI.Views.ImageViewerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- Khung xem ảnh dùng chung cho "Ảnh gốc" và "Ảnh xử lý".
         Title: tiêu đề. Display: ảnh + đối tượng vẽ chồng (ImageDisplay), gắn từ ViewModel.
         Điều khiển Halcon được tạo bằng code (ImageViewerPanel.xaml.cs). Lăn chuột để phóng to/thu nhỏ, kéo để dời. -->
    <Border Background="{StaticResource VsPanelBrush}">
        <DockPanel>

            <!-- Thanh tiêu đề -->
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}" Padding="8,2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Ô chọn đặt ROI ở khung này (chỉ hiện khi RoiToggleLabel có chữ) -->
                        <CheckBox x:Name="RoiToggleBox" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="RoiToggle_Changed" Unchecked="RoiToggle_Changed"
                                  ToolTip="Vẽ / kéo ROI của node đang chọn ngay trên ảnh ở khung này thay vì ảnh gốc" />
                        <!-- Xóa viền khi học mẫu (chỉ hiện khi node đang chọn có tham số EraseAreas, vd FindShape) -->
                        <Button x:Name="EraseRectButton" Content="+ Xóa ▭" Click="EraseRect_Click" Visibility="Collapsed"
                                ToolTip="Thêm vùng chữ nhật: đường viền nằm trong vùng này sẽ KHÔNG vào mẫu. Kéo, đổi cỡ rồi bấm Xác nhận" />
                        <Button x:Name="EraseCircleButton" Content="+ Xóa ○" Click="EraseCircle_Click" Visibility="Collapsed"
                                ToolTip="Thêm vùng tròn không lấy viền" />
                        <Button x:Name="EraseOkButton" Content="Xác nhận xóa" Click="EraseOk_Click" Visibility="Collapsed" />
                        <Button x:Name="EraseCancelButton" Content="Hủy" Click="EraseCancel_Click" Visibility="Collapsed" />
                        <Button x:Name="EraseClearButton" Content="Bỏ hết vùng xóa" Click="EraseClear_Click" Visibility="Collapsed"
                                ToolTip="Xóa danh sách vùng xóa viền của node đang chọn" />
                        <Button Content="Vừa khung" Click="FitButton_Click" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding Title, ElementName=Root, Mode=OneWay}" />
                        <Run Text="{Binding CaptionText, ElementName=Root, Mode=OneWay}"
                             Foreground="{StaticResource VsMutedBrush}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Thanh thông tin dưới cùng -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource VsPanelHeaderBrush}"
                    BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0" Padding="8,3">
                <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource VsMutedBrush}">
                    <TextBlock x:Name="SizeText" Text="Kích thước: -" />
                </StackPanel>
            </Border>

            <!-- Vùng hiển thị ảnh: điều khiển Halcon được thêm vào đây -->
            <Grid x:Name="ImageHost" Background="{StaticResource VsImageBgBrush}" ClipToBounds="True" />
        </DockPanel>
    </Border>
</UserControl>
