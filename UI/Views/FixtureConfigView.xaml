<UserControl x:Class="UI.Views.FixtureConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Bảng tối (theme chung chưa có kiểu cho DataGrid) -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{StaticResource VsPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource VsTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource VsBorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource VsPanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#2A2A2D" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource VsBorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource VsPanelHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource VsTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource VsBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource VsSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{StaticResource VsTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource VsTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ô nhập gọn trong bảng -->
        <Style x:Key="CellBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="HeaderText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource VsAccentBrush}" />
            <Setter Property="Margin" Value="4,0,4,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,20">
        <StackPanel>

            <!-- ============ CÀI ĐẶT CHUNG (gọn, nhiều cột) ============ -->
            <TextBlock Text="Cài đặt chung" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
            <ItemsControl ItemsSource="{Binding CommonFields}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="190" Margin="0,0,14,8"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource VsMutedBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}" />
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                     Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text, Mode=TwoWay}"
                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                            <CheckBox IsChecked="{Binding BoolValue}" Margin="0,5,0,0" Content="Bật"
                                      Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource VsMutedBrush}" FontSize="11"
                                       Visibility="{Binding IsTerminator, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource VsDangerBrush}" FontSize="11"
                                       TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Quét IP máy này" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"
                    Command="{Binding ScanIpCommand}" />

            <!-- ============ DANH SÁCH KHUÔN TEST: mỗi khuôn một dòng ============ -->
            <DockPanel Margin="0,18,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="+ Thêm khuôn" Style="{StaticResource OutlineButton}" Command="{Binding AddDeviceCommand}" />
                    <Button Content="Xóa khuôn đang chọn" Style="{StaticResource OutlineButton}" Command="{Binding RemoveDeviceCommand}" />
                </StackPanel>
                <TextBlock Text="Các khuôn test (sửa trực tiếp trong bảng)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <DataGrid x:Name="FixtureGrid" ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      PreviewMouseWheel="ForwardWheel">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource VsMutedBrush}"
                                         HorizontalAlignment="Center" ToolTip="{Binding StatusText}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource VsOkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Bật" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tên" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding NameError}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SS" Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[FixtureNo].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="Số khuôn dùng trong lệnh, ví dụ 1 → OPEN_01" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="IP" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[Ip].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding FieldMap[Ip].Error}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Cổng" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[Port].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding FieldMap[Port].Error}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Slot" Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[Slots].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding FieldMap[Slots].Error}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thanh ghi KQ" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[ResultReg].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding FieldMap[ResultReg].Error}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Bit có bản" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[HasSampleBit].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding FieldMap[HasSampleBit].Error}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Timeout test (s)" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[TestTimeoutS].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding FieldMap[TestTimeoutS].Error}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Nghỉ Đóng→Mở (ms)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FieldMap[CloseToOpenMs].Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CellBox}"
                                         ToolTip="{Binding FieldMap[CloseToOpenMs].Error}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Chỉ đóng" Width="62">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding FieldMap[CloseOnly].BoolValue}" HorizontalAlignment="Center"
                                          ToolTip="Chỉ đóng, không gửi SN" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="PLC nguồn" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="0,1"
                                          ItemsSource="{Binding DataContext.Plcs, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SourcePlc, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Kết nối" Width="*" MinWidth="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="Kết nối" Style="{StaticResource AccentButton}"
                                            Command="{Binding ConnectCommand}" />
                                    <Button DockPanel.Dock="Left" Content="Ngắt" Style="{StaticResource OutlineButton}"
                                            Command="{Binding DisconnectCommand}" />
                                    <TextBlock Text="{Binding Message}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"
                                               Foreground="{StaticResource VsMutedBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Gửi thử một dòng tới khuôn đang chọn -->
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource VsMutedBrush}">
                    <Run Text="Gửi thử tới" /> <Run Text="{Binding SelectedDevice.Name, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="Gửi thử" Style="{StaticResource OutlineButton}"
                        IsEnabled="{Binding SelectedDevice.IsConnected}" Command="{Binding SelectedDevice.SendTestCommand}" />
                <TextBox Text="{Binding SelectedDevice.TestText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellBox}" />
            </DockPanel>

            <!-- ============ TRẠNG THÁI VÀ ĐIỀU KHIỂN TỪNG KHUÔN ============ -->
            <DockPanel Margin="0,18,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Mở tất cả" Style="{StaticResource AccentButton}" Command="{Binding OpenAllCommand}"
                            ToolTip="Gửi OPEN ALL qua khuôn đang chọn (không có thì khuôn đã nối đầu tiên)" />
                    <Button Content="Đóng tất cả" Style="{StaticResource OutlineButton}" Command="{Binding CloseAllCommand}"
                            ToolTip="Gửi CLOSE ALL qua khuôn đang chọn (không có thì khuôn đã nối đầu tiên)" />
                </StackPanel>
                <TextBlock Text="Trạng thái và điều khiển từng khuôn" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource VsPanelBrush}" BorderBrush="{StaticResource VsBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Mở" Style="{StaticResource OutlineButton}" Width="64"
                                                IsEnabled="{Binding IsConnected}" Command="{Binding FixtureOpenCommand}" />
                                        <Button Content="Đóng" Style="{StaticResource OutlineButton}" Width="64"
                                                IsEnabled="{Binding IsConnected}" Command="{Binding FixtureCloseCommand}" />
                                        <Button Content="Kiểm sensor" Style="{StaticResource OutlineButton}"
                                                IsEnabled="{Binding IsConnected}" Command="{Binding FixtureCheckSensorCommand}"
                                                ToolTip="Xem trong khuôn có hàng không (CHECKSENSOR)" />
                                        <Button Content="Kiểm trạng thái" Style="{StaticResource OutlineButton}"
                                                IsEnabled="{Binding IsConnected}" Command="{Binding FixtureStateCommand}"
                                                ToolTip="Hỏi khuôn đang mở hay đóng (STATE)" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Margin="8,0,0,0" Foreground="{StaticResource VsMutedBrush}">
                                            <Run Text="khuôn" /> <Run Text="{Binding FixtureNo, Mode=OneWay, StringFormat=00}" />
                                        </TextBlock>
                                        <Border Background="{StaticResource VsInputBrush}" CornerRadius="3" Padding="8,1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding FixtureStateText}" />
                                        </Border>
                                        <Border Background="{StaticResource VsInputBrush}" CornerRadius="3" Padding="8,1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding SensorText}" />
                                        </Border>
                                        <TextBlock Text="chưa kết nối" Margin="10,0,0,0" Foreground="{StaticResource VsDangerBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Từng slot: số slot theo ô "Số slot" của khuôn, màu và chữ theo trạng thái -->
                                <ItemsControl ItemsSource="{Binding Slots}" Margin="0,8,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="104" Height="58" CornerRadius="4" Margin="0,0,8,6" Padding="8,5"
                                                    BorderThickness="1" BorderBrush="{StaticResource VsButtonBorderBrush}">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{StaticResource VsInputBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Busy">
                                                                <Setter Property="Background" Value="#0A6FC2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Empty">
                                                                <Setter Property="Background" Value="#55555C" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Pass">
                                                                <Setter Property="Background" Value="#23863F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Repair">
                                                                <Setter Property="Background" Value="#9A6B00" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Fail">
                                                                <Setter Property="Background" Value="#C42B1C" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Nan">
                                                                <Setter Property="Background" Value="#7B4FB8" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                                <Setter Property="Background" Value="#C2410C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#E6E6E6" FontSize="11" />
                                                    <TextBlock Text="{Binding StateText}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="2,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource VsMutedBrush}" FontSize="11"
                       Text="Slot đổi trạng thái khi nhận dòng kết quả đúng mẫu ở bảng 'Kết quả từng slot' (hoặc khi lệnh được trả lời bằng dòng đó). Đổi 'Slot' trong bảng khuôn thì số ô ở đây đổi theo." />

            <!-- ============ BẢNG LỆNH ============ -->
            <TextBlock Text="Lệnh gửi khuôn test" Style="{StaticResource SectionTitle}" />
            <Border Background="{StaticResource VsPanelBrush}" BorderBrush="{StaticResource VsBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8,8,8,4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lệnh" Style="{StaticResource HeaderText}" />
                        <TextBlock Grid.Column="1" Text="Gửi" Style="{StaticResource HeaderText}" />
                        <TextBlock Grid.Column="2" Text="Trả lời OK / YES / OPENED" Style="{StaticResource HeaderText}" />
                        <TextBlock Grid.Column="3" Text="Trả lời ERROR / NO / CLOSED" Style="{StaticResource HeaderText}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CommandRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
                                    <TextBox Grid.Column="1" Margin="4,0" Style="{StaticResource CellBox}" ToolTip="{Binding Send.Error}"
                                             Text="{Binding Send.Text, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="2" Margin="4,0" Style="{StaticResource CellBox}" ToolTip="{Binding Ok.Error}"
                                             Text="{Binding Ok.Text, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="3" Margin="4,0" Style="{StaticResource CellBox}" ToolTip="{Binding Err.Error}"
                                             Text="{Binding Err.Text, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ BẢNG KẾT QUẢ SLOT ============ -->
            <TextBlock Text="Kết quả từng slot" Style="{StaticResource SectionTitle}" />
            <Border Background="{StaticResource VsPanelBrush}" BorderBrush="{StaticResource VsBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8,8,8,4" HorizontalAlignment="Left" MinWidth="520">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tên" Style="{StaticResource HeaderText}" />
                        <TextBlock Grid.Column="1" Text="Nhận về" Style="{StaticResource HeaderText}" />
                        <TextBlock Grid.Column="2" Text="Mã gửi PLC" Style="{StaticResource HeaderText}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ResultRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBox Grid.Column="1" Margin="4,0" Style="{StaticResource CellBox}" ToolTip="{Binding Pattern.Error}"
                                             Text="{Binding Pattern.Text, UpdateSourceTrigger=LostFocus}"
                                             Visibility="{Binding HasPattern, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Column="1" Text="—" Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource VsMutedBrush}"
                                               Visibility="{Binding NoPattern, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Grid.Column="2" Margin="4,0" Style="{StaticResource CellBox}" ToolTip="{Binding Plc.Error}"
                                             Text="{Binding Plc.Text, UpdateSourceTrigger=LostFocus}"
                                             Visibility="{Binding HasPlc, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Column="2" Text="—" Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource VsMutedBrush}"
                                               Visibility="{Binding NoPlc, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Margin="2,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource VsMutedBrush}" FontSize="11"
                       Text="{}{SS} = số khuôn (khuôn 1, khuôn 2...). {NN} = số slot trong khuôn (một khuôn có 1, 2, 3... ô để test hàng). {SLOTS} = danh sách slot bị lỗi. Các mẫu này dùng chung cho mọi khuôn." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
