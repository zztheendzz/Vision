<Window x:Class="UI.Views.DeviceConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Views"
        mc:Ignorable="d"
        Title="DeviceConfigWindow" Height="450" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    </Window.InputBindings>


    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>

        <!-- ================= THANH DƯỚI: Lưu / Đóng ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource VsPanelHeaderBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Kết nối tất cả" Style="{StaticResource OutlineButton}"
                            Command="{Binding ConnectAllCommand}" />
                    <Button Content="Ngắt tất cả" Style="{StaticResource OutlineButton}"
                            Command="{Binding DisconnectAllCommand}" />
                    <Button Content="Lưu" Width="90" Style="{StaticResource AccentButton}"
                            Command="{Binding SaveCommand}" ToolTip="Lưu (Ctrl+S)" />
                    <Button Content="Đóng" Width="90" Style="{StaticResource OutlineButton}"
                            Click="Close_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionAlert}" VerticalAlignment="Center" Margin="12,0"
                           Foreground="#FF6B6B" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource VsMutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ================= MỖI LOẠI THIẾT BỊ MỘT TAB ================= -->
        <TabControl ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Khuôn test: giao diện riêng (bảng tất cả khuôn + bảng lệnh); chỉ tạo cho tab khuôn test -->
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFixture}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <local:FixtureConfigView />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFixture}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cột trái: danh sách thiết bị của loại này, thêm / xóa -->
                            <Border Background="{StaticResource VsPanelBrush}"
                                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                                        <TextBlock Text="Thiết bị" />
                                    </Border>

                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
                                        <Button Content="+ Thêm" Style="{StaticResource OutlineButton}"
                                            Command="{Binding AddDeviceCommand}" />
                                        <Button Content="Xóa" Style="{StaticResource OutlineButton}"
                                            Command="{Binding RemoveDeviceCommand}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="10" Height="10"
                                                         Fill="{StaticResource VsMutedBrush}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource VsOkBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Cột phải: cài đặt chung của loại + chi tiết thiết bị đang chọn -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,20">
                                <StackPanel>

                                    <!-- Cài đặt chung (chỉ loại nào có mới hiện) -->
                                    <StackPanel Visibility="{Binding HasGroupFields, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Cài đặt chung" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <local:FieldsEditor Fields="{Binding GroupFields}" />
                                        <Button Content="Quét IP" Style="{StaticResource OutlineButton}"
                                            HorizontalAlignment="Left" Margin="190,8,0,0"
                                            Command="{Binding ScanIpCommand}"
                                            Visibility="{Binding IsFixture, Converter={StaticResource BoolToVis}}" />
                                        <Rectangle Height="1" Fill="{StaticResource VsBorderBrush}" Margin="0,18,0,0" />
                                    </StackPanel>

                                    <!-- Thiết bị đang chọn; chưa chọn gì thì ContentControl rỗng, không hiện gì -->
                                    <ContentControl Content="{Binding SelectedDevice}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

                                                    <!-- ===== THẺ ĐẦU: tên, trạng thái, nút Kết nối / Ngắt luôn nhìn thấy ===== -->
                                                    <Border Background="{StaticResource VsPanelBrush}"
                                                        BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="16,12" Margin="0,12,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <!-- Tên: gõ xong rời ô thì đổi; trống hoặc trùng thì bị từ chối -->
                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                                     FontSize="16" FontWeight="SemiBold"
                                                                     MinWidth="220" MaxWidth="360" HorizontalAlignment="Left" />
                                                                <TextBlock Text="{Binding NameError}" FontSize="11" Margin="2,2,0,0"
                                                                       Foreground="{StaticResource VsDangerBrush}" />
                                                                <TextBlock Text="{Binding Summary}" Margin="2,4,0,0"
                                                                       Foreground="{StaticResource VsMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                                                                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                                                         Fill="{StaticResource VsMutedBrush}" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                                                    <CheckBox Content="Bật thiết bị" IsChecked="{Binding Enabled}"
                                                                          Margin="20,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                                <Button Content="Kết nối" Width="90" Style="{StaticResource AccentButton}"
                                                                    Command="{Binding ConnectCommand}" />
                                                                <Button Content="Ngắt" Width="70" Style="{StaticResource OutlineButton}"
                                                                    Command="{Binding DisconnectCommand}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Kết quả thao tác gần nhất: ngay dưới thẻ đầu, không bị đẩy xuống dưới khung xem trước -->
                                                    <TextBlock Text="{Binding Message}" Margin="4,8,0,0" FontWeight="SemiBold"
                                                           Foreground="{StaticResource VsAccentBrush}" TextWrapping="Wrap" />

                                                    <!-- ===== CÁC TAB: Thông số / Điều khiển (robot) / Thử nghiệm ===== -->
                                                    <TabControl Margin="0,12,0,0" Background="Transparent">

                                                        <!-- Tab: Thông số -->
                                                        <TabItem Header="Thông số">
                                                            <StackPanel Margin="4,8,4,16">
                                                                <!-- PLC nguồn: đổi tên PLC thì tên ở đây tự đổi theo -->
                                                                <Grid Margin="0,6,0,0"
                                                                  Visibility="{Binding HasPlcSource, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="190" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="PLC nguồn" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource VsMutedBrush}" />
                                                                    <ComboBox Grid.Column="1" MinWidth="200" HorizontalAlignment="Left"
                                                                          ItemsSource="{Binding DataContext.Plcs, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                          SelectedItem="{Binding SourcePlc, Mode=TwoWay}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Name}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>

                                                                <local:FieldsEditor Fields="{Binding Fields}" />

                                                                <!-- Camera: quét danh sách để chọn thiết bị -->
                                                                <StackPanel Orientation="Horizontal" Margin="190,10,0,0"
                                                                        Visibility="{Binding IsCamera, Converter={StaticResource BoolToVis}}">
                                                                    <Button Content="Quét camera" Style="{StaticResource OutlineButton}"
                                                                        Command="{Binding ScanCamerasCommand}" />
                                                                    <ComboBox MinWidth="220" Margin="8,0,0,0"
                                                                          ItemsSource="{Binding FoundCameras}" DisplayMemberPath="Display"
                                                                          SelectedItem="{Binding SelectedFound, Mode=TwoWay}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </TabItem>

                                                        <!-- Tab: Robot: điều khiển thủ công -->
                                                        <TabItem Header="Điều khiển"
                                                             Visibility="{Binding IsRobot, Converter={StaticResource BoolToVis}}">
                                                            <local:RobotControlView />
                                                        </TabItem>

                                                        <!-- Tab: Thử nghiệm: PLC, camera, thiết bị nói chuyện bằng chữ -->
                                                        <TabItem Header="Thử nghiệm"
                                                             Visibility="{Binding HasTestTab, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Margin="4,8,4,16">

                                                                <!-- PLC: đọc thử một bit / một thanh ghi để kiểm tra kết nối và địa chỉ -->
                                                                <StackPanel Visibility="{Binding IsPlc, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Đọc thử" FontWeight="SemiBold" Margin="0,6,0,6"
                                                                           Foreground="{StaticResource VsAccentBrush}" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Địa chỉ" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                               Foreground="{StaticResource VsMutedBrush}" />
                                                                        <TextBox Text="{Binding ReadAddress, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                                                        <Button Content="Đọc bit" Style="{StaticResource OutlineButton}"
                                                                            IsEnabled="{Binding IsConnected}" Command="{Binding ReadBitCommand}" />
                                                                        <Button Content="Đọc thanh ghi" Style="{StaticResource OutlineButton}"
                                                                            IsEnabled="{Binding IsConnected}" Command="{Binding ReadWordCommand}" />
                                                                    </StackPanel>

                                                                    <!-- PLC giả lập: đặt bit bằng tay (ví dụ bit yêu cầu chụp) để thử chạy tự động -->
                                                                    <StackPanel Margin="0,10,0,0"
                                                                            Visibility="{Binding IsSimulatedPlc, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="PLC giả lập: ghi bit theo địa chỉ ở trên" Foreground="{StaticResource VsMutedBrush}" />
                                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                            <Button Content="Đặt = 1" Style="{StaticResource OutlineButton}"
                                                                                IsEnabled="{Binding IsConnected}" Command="{Binding WriteBitOnCommand}" />
                                                                            <Button Content="Đặt = 0" Style="{StaticResource OutlineButton}"
                                                                                IsEnabled="{Binding IsConnected}" Command="{Binding WriteBitOffCommand}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Camera: xem trực tiếp / chụp, khung xem trước -->
                                                                <StackPanel Visibility="{Binding IsCamera, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Xem trước" FontWeight="SemiBold" Margin="0,6,0,6"
                                                                           Foreground="{StaticResource VsAccentBrush}" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Style="{StaticResource OutlineButton}"
                                                                            IsEnabled="{Binding IsConnected}"
                                                                            Command="{Binding ToggleLiveCommand}">
                                                                            <Button.Content>
                                                                                <TextBlock>
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Text" Value="Xem trực tiếp" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                                                    <Setter Property="Text" Value="Dừng xem" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Button.Content>
                                                                        </Button>
                                                                        <Button Content="Chụp" Style="{StaticResource OutlineButton}"
                                                                            IsEnabled="{Binding IsConnected}"
                                                                            Command="{Binding SnapCommand}" />
                                                                    </StackPanel>
                                                                    <!-- Thông số ảnh / camera: chỉnh khi đang xem -->
                                                                    <StackPanel Margin="0,10,0,0" IsEnabled="{Binding IsConnected}">
                                                                        <TextBlock Text="Thông số ảnh và camera (chỉnh khi đang xem)" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource VsAccentBrush}" Margin="0,0,0,4" />
                                                                        <ItemsControl ItemsSource="{Binding CameraParams}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="150" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="90" />
                                                                                            <ColumnDefinition Width="40" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Grid.RowDefinitions>
                                                                                            <RowDefinition Height="Auto" />
                                                                                            <RowDefinition Height="Auto" />
                                                                                        </Grid.RowDefinitions>
                                                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                                                        <Slider Grid.Column="1" Margin="6,0" VerticalAlignment="Center"
                                                                                            IsEnabled="{Binding IsSupported}"
                                                                                            Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                                            Value="{Binding Value, Mode=TwoWay}" />
                                                                                        <TextBox Grid.Column="2" IsEnabled="{Binding IsSupported}"
                                                                                             Text="{Binding Value, StringFormat=0.##, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                                                        <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="6,0,0,0"
                                                                                               VerticalAlignment="Center" Foreground="{StaticResource VsMutedBrush}" />
                                                                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Status}"
                                                                                               Margin="6,0,0,0" Foreground="{StaticResource VsMutedBrush}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                            <Button Content="Đọc lại từ camera" Style="{StaticResource OutlineButton}"
                                                                                Command="{Binding ReadCameraParamsCommand}" />
                                                                            <Button Content="Lưu thông số camera vào cấu hình" Style="{StaticResource OutlineButton}"
                                                                                Command="{Binding SaveCameraParamsToConfigCommand}" />
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <local:ImageViewerPanel Title="Xem trước camera"
                                                                                        Display="{Binding Preview}"
                                                                                        Height="340" Margin="0,8,0,0" />
                                                                </StackPanel>

                                                                <!-- Thiết bị nói chuyện bằng chữ (khuôn test, PC): gửi thử một dòng -->
                                                                <StackPanel Visibility="{Binding CanSendText, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Gửi thử" FontWeight="SemiBold" Margin="0,6,0,6"
                                                                           Foreground="{StaticResource VsAccentBrush}" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBox Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}" Width="280" />
                                                                        <Button Content="Gửi thử" Style="{StaticResource OutlineButton}"
                                                                            IsEnabled="{Binding IsConnected}" Command="{Binding SendTestCommand}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </TabItem>
                                                    </TabControl>

                                                </StackPanel>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource VsOkBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>


</Window>
