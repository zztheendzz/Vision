<UserControl x:Class="UI.Views.ToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Views"
             xmlns:vm="clr-namespace:UI.ViewModels.ToolboxAndParam"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Cho các nhóm tự mở sẵn -->
        <Style x:Key="GroupItemStyle" TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource VsPanelBrush}">
        <DockPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                <TextBlock Text="Toolbox" />
            </Border>

            <TextBox DockPanel.Dock="Top" Margin="6" ToolTip="Tìm tool..."
                     Text="{Binding Toolbox.SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock DockPanel.Dock="Bottom" Margin="8,4,8,8" TextWrapping="Wrap"
                       Foreground="{StaticResource VsMutedBrush}"
                       Text="Kéo một tool thả vào đồ thị để tạo node." />

            <!-- Danh sách tool theo nhóm. Kéo một tool (không phải tên nhóm) sang đồ thị để tạo node. -->
            <TreeView x:Name="Tree"
                      ItemsSource="{Binding Toolbox.Groups}"
                      ItemContainerStyle="{StaticResource GroupItemStyle}"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="Tree_PreviewMouseMove">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ToolboxGroupViewModel}"
                                              ItemsSource="{Binding Items}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type vm:ToolboxItemViewModel}">
                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}" />
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>
    </Border>
</UserControl>
