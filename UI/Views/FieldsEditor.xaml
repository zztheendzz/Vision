<UserControl x:Class="UI.Views.FieldsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <!-- Danh sách ô nhập, gom theo Section. Mỗi ô: nhãn bên trái, ô nhập bên phải, lỗi / ghi chú bên dưới. -->
        <ItemsControl x:Name="Items" Focusable="False">
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="0,14,0,6" FontWeight="SemiBold"
                                   Foreground="{StaticResource VsAccentBrush}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,5,8,0"
                               Foreground="{StaticResource VsMutedBrush}" TextWrapping="Wrap" />

                        <StackPanel Grid.Column="1">
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" MaxWidth="320"
                                 HorizontalAlignment="Left" MinWidth="200"
                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />

                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text, Mode=TwoWay}"
                                  MinWidth="200" HorizontalAlignment="Left"
                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />

                            <CheckBox IsChecked="{Binding BoolValue}" VerticalAlignment="Center" Margin="0,5,0,0"
                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource VsMutedBrush}"
                                   Margin="2,2,0,0" Visibility="{Binding IsTerminator, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Hint}" Foreground="{StaticResource VsMutedBrush}" FontSize="11"
                                   Margin="2,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource VsDangerBrush}" FontSize="11"
                                   Margin="2,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
