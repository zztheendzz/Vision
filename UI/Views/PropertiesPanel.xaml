<UserControl x:Class="UI.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Views"
             xmlns:vm="clr-namespace:UI.ViewModels.ToolboxAndParam"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Ô chữ tự ẩn khi rỗng (dùng cho dòng báo lỗi và dòng mô tả) -->
        <Style x:Key="OptionalText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Giao diện cho tham số dạng chữ/số -->
        <DataTemplate DataType="{x:Type vm:TextParameterViewModel}">
            <StackPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource VsMutedBrush}" />
                <TextBox Margin="0,2,0,0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource OptionalText}" Foreground="#F48771" Margin="0,2,0,0"
                           Text="{Binding ErrorMessage}" />
                <TextBlock Style="{StaticResource OptionalText}" Foreground="{StaticResource VsMutedBrush}"
                           FontStyle="Italic" Margin="0,2,0,0" Text="{Binding Description}" />
            </StackPanel>
        </DataTemplate>

        <!-- Giao diện cho tham số chọn từ danh sách (enum) -->
        <DataTemplate DataType="{x:Type vm:EnumParameterViewModel}">
            <StackPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource VsMutedBrush}" />
                <ComboBox Margin="0,2,0,0" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource OptionalText}" Foreground="{StaticResource VsTextBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Help}" />
                <TextBlock Style="{StaticResource OptionalText}" Foreground="#F48771" Margin="0,2,0,0"
                           Text="{Binding ErrorMessage}" />
                <TextBlock Style="{StaticResource OptionalText}" Foreground="{StaticResource VsMutedBrush}"
                           FontStyle="Italic" Margin="0,2,0,0" Text="{Binding Description}" />
            </StackPanel>
        </DataTemplate>

        <!-- Giao diện cho tham số bật/tắt -->
        <DataTemplate DataType="{x:Type vm:BoolParameterViewModel}">
            <StackPanel Margin="0,4,0,8">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                <TextBlock Style="{StaticResource OptionalText}" Foreground="#F48771" Margin="0,2,0,0"
                           Text="{Binding ErrorMessage}" />
                <TextBlock Style="{StaticResource OptionalText}" Foreground="{StaticResource VsMutedBrush}"
                           FontStyle="Italic" Margin="0,2,0,0" Text="{Binding Description}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource VsPanelBrush}">
        <DockPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                <TextBlock Text="Thuộc tính" />
            </Border>

            <Grid>
                <!-- Hiện khi chưa chọn node nào -->
                <TextBlock Text="Chọn một node trong đồ thị để xem và chỉnh tham số."
                           TextWrapping="Wrap" Margin="12" Foreground="{StaticResource VsMutedBrush}" />

                <!-- Hiện khi đã chọn node -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource VsPanelBrush}"
                              Visibility="{Binding Properties.HasNode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="10,8,10,12">

                        <TextBlock Text="{Binding Properties.Node.Title}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Properties.KindText}" Foreground="{StaticResource VsMutedBrush}"
                                   Margin="0,2,0,10" />

                        <TextBlock Text="CHÚ THÍCH" Foreground="{StaticResource VsAccentBrush}"
                                   FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBox Text="{Binding Properties.Node.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                                 ToolTip="Ghi chú cho node này. Hiện ngay trên node trong đồ thị." />

                        <TextBlock Text="THAM SỐ" Foreground="{StaticResource VsAccentBrush}"
                                   FontWeight="SemiBold" Margin="0,4,0,4" />

                        <TextBlock Text="Tool này không có tham số." Foreground="{StaticResource VsMutedBrush}"
                                   Visibility="{Binding Properties.HasNoParameters, Converter={StaticResource BoolToVis}}" />

                        <!-- Mỗi tham số một ô nhập, kiểu ô do DataTemplate ở trên quyết định -->
                        <ItemsControl ItemsSource="{Binding Properties.Parameters}" />

                        <TextBlock Text="LẦN CHẠY GẦN NHẤT" Foreground="{StaticResource VsAccentBrush}"
                                   FontWeight="SemiBold" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Trạng thái" Foreground="{StaticResource VsMutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Properties.Node.Status}" Margin="0,2" />

                            <TextBlock Grid.Row="1" Text="Thời gian" Foreground="{StaticResource VsMutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2"
                                       Text="{Binding Properties.Node.ElapsedMs, StringFormat={}{0} ms}" />

                            <TextBlock Grid.Row="2" Text="Thông điệp" Foreground="{StaticResource VsMutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,2"
                                       Text="{Binding Properties.Node.Message}" />

                            <TextBlock Grid.Row="3" Text="Id" Foreground="{StaticResource VsMutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,2"
                                       Text="{Binding Properties.Node.Model.Id}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
