<UserControl x:Class="UI.View.GraphEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:local="clr-namespace:UI.View"
             xmlns:vm="clr-namespace:UI.ViewModels"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Trình soạn thảo đồ thị. DataContext là MainViewModel (kế thừa từ MainWindow). -->
        <!-- Trình soạn thảo đồ thị. DataContext là MainViewModel (kế thừa từ MainWindow). -->
        <nodify:NodifyEditor x:Name="GraphCanvas" AllowDrop="True"
                         DragOver="Canvas_DragOver" Drop="Canvas_Drop"
                         ItemsSource="{Binding Editor.Nodes}"
                         Connections="{Binding Editor.Connections}"
                         SelectedItems="{Binding Editor.SelectedNodes}"
                         PendingConnection="{Binding Editor.PendingConnection}"
                         DisconnectConnectorCommand="{Binding Editor.DisconnectConnectorCommand}">

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                    <nodify:Connection Source="{Binding Source.Anchor}"
                                   Target="{Binding Target.Anchor}" />
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                    <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                          CompletedCommand="{Binding CompleteCommand}" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                    <nodify:Node x:Name="NodeControl"
                             Header="{Binding Title}"
                             Input="{Binding Inputs}"
                             Output="{Binding Outputs}"
                             HeaderBrush="#455A64"
                             ToolTip="{Binding Message}">

                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                <nodify:NodeInput Header="{Binding Name}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ToolTip="{Binding TypeName}" />
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>

                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                <nodify:NodeOutput Header="{Binding Name}"
                                               IsConnected="{Binding IsConnected}"
                                               Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                               ToolTip="{Binding TypeName}" />
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>

                        <TextBlock Text="{Binding Message}" MaxWidth="180"
                               TextTrimming="CharacterEllipsis" Margin="6,2" />
                    </nodify:Node>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Ok">
                            <Setter TargetName="NodeControl" Property="HeaderBrush" Value="#2E7D32" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter TargetName="NodeControl" Property="HeaderBrush" Value="#C62828" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Skipped">
                            <Setter TargetName="NodeControl" Property="HeaderBrush" Value="#757575" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
        </nodify:NodifyEditor>

    </Grid>
</UserControl>
