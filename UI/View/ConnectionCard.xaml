<UserControl x:Class="UI.View.ConnectionCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.View"
             xmlns:views="clr-namespace:UI.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Một thẻ kết nối: Robot, PLC, PC, Fixture hoặc Scanner -->
        <Border Background="{StaticResource VsPanelBrush}" BorderBrush="{StaticResource VsBorderBrush}"
            BorderThickness="1" CornerRadius="3" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hàng 1: ký hiệu, tên, giao thức, trạng thái -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="4" Background="{StaticResource VsAccentBrush}">
                        <TextBlock Text="{Binding Badge, ElementName=Root}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Protocol, ElementName=Root}" Foreground="{StaticResource VsMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource VsMutedBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Chưa kết nối" Foreground="{StaticResource VsMutedBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Hàng 2: địa chỉ và cổng -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Địa chỉ" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                         Text="{Binding Address, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Cổng" VerticalAlignment="Center" Margin="10,0,8,0" />
                    <TextBox Grid.Column="3"
                         Text="{Binding Port, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Hàng 3: nút -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Kết nối" Style="{StaticResource AccentButton}" />
                    <Button Content="Ngắt" Style="{StaticResource OutlineButton}" />
                    <Button Content="Kiểm tra" Style="{StaticResource OutlineButton}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
