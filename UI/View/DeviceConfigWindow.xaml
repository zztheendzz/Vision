<Window x:Class="UI.View.DeviceConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.View"
        mc:Ignorable="d"
        Title="DeviceConfigWindow" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Chữ nhãn bên trái mỗi ô nhập -->
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource VsMutedBrush}" />
        </Style>

        <!-- Tiêu đề từng nhóm -->
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource VsAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </Window.Resources>
    <Grid>


        <DockPanel>

            <!-- ================= THANH DƯỚI: Lưu / Đóng ================= -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource VsPanelHeaderBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Lưu" Width="90" Style="{StaticResource AccentButton}"
                            Command="{Binding SaveCommand}" />
                        <Button Content="Đóng" Width="90" Style="{StaticResource OutlineButton}"
                            Click="Close_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource VsMutedBrush}" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= CỘT TRÁI: DANH SÁCH THIẾT BỊ ================= -->
                <Border Background="{StaticResource VsPanelBrush}"
                    BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                            <TextBlock Text="Thiết bị" />
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
                            <Button Content="+ Thêm thiết bị" Style="{StaticResource OutlineButton}"
                                Command="{Binding AddDeviceCommand}" />
                            <Button Content="Xóa" Style="{StaticResource OutlineButton}"
                                Command="{Binding RemoveDeviceCommand}" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <!-- Chấm trạng thái: xám là chưa kết nối, xanh lá là đang kết nối -->
                                        <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="10" Height="10"
                                             Fill="{StaticResource VsMutedBrush}" Margin="0,0,10,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Foreground="{StaticResource VsMutedBrush}">
                                            <Run Text="{Binding Type, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding IpAddress, Mode=OneWay}" />
                                            <Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource VsOkBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ================= CỘT PHẢI: CHI TIẾT THIẾT BỊ ĐANG CHỌN ================= -->
                <Grid Grid.Column="1">

                    <TextBlock Text="Chưa có thiết bị. Bấm &quot;+ Thêm thiết bị&quot; để tạo."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource VsMutedBrush}" />

                    <!-- Các ô bên trong dùng thiết bị đang chọn làm DataContext. Không chọn gì thì ẩn cả khối. -->
                    <Border Background="{StaticResource VsWindowBrush}" DataContext="{Binding SelectedDevice}">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,8,20,20" MaxWidth="600" HorizontalAlignment="Left">

                                <!-- THÔNG TIN -->
                                <TextBlock Text="THÔNG TIN" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Tên thiết bị" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Text="Loại" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" Width="200" HorizontalAlignment="Left"
                                          ItemsSource="{Binding DataContext.DeviceTypes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedItem="{Binding Type}" />
                                </Grid>

                                <!-- KẾT NỐI -->
                                <TextBlock Text="KẾT NỐI (TCP/IP)" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Địa chỉ IP" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Text="Cổng (port)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Text="Thời gian chờ (ms)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left"
                                         Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />

                                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                                          Content="Tự kết nối khi mở phần mềm"
                                          IsChecked="{Binding AutoConnect}" />
                                </Grid>

                                <!-- GÓI TIN -->
                                <TextBlock Text="GÓI TIN" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Mã hóa chữ" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" Width="200" HorizontalAlignment="Left"
                                          ItemsSource="{Binding DataContext.Encodings, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedItem="{Binding TextEncoding}" />

                                    <TextBlock Grid.Row="1" Text="Ký tự kết thúc gói" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" Width="200" HorizontalAlignment="Left"
                                          ItemsSource="{Binding DataContext.TerminatorKinds, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedItem="{Binding Terminator}" />

                                    <!-- Chỉ hiện khi chọn Custom -->
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2"
                                      Visibility="{Binding IsCustomTerminator, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ký tự tùy chọn" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Margin="0,3" Width="200" HorizontalAlignment="Left"
                                             Text="{Binding CustomTerminator, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="Mã byte" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Width="200" HorizontalAlignment="Left"
                                         IsReadOnly="True" FontFamily="Consolas"
                                         Text="{Binding TerminatorPreview, Mode=OneWay}" />

                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource VsMutedBrush}"
                                           Text="CR = \r (0D), LF = \n (0A), CRLF = \r\n (0D 0A). Với Custom có thể gõ ký tự thường hoặc mã đặc biệt: \r  \n  \t  \0  \xHH (ví dụ \x03)." />
                                </Grid>

                                <!-- TRẠNG THÁI VÀ KIỂM TRA -->
                                <TextBlock Text="TRẠNG THÁI VÀ KIỂM TRA" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="{StaticResource VsMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource VsOkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Message}" Margin="14,0,0,0" MaxWidth="380"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{StaticResource VsMutedBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Kết nối" Width="90" Style="{StaticResource AccentButton}"
                                        Command="{Binding ConnectCommand}" />
                                    <Button Content="Ngắt" Width="90" Style="{StaticResource OutlineButton}"
                                        Command="{Binding DisconnectCommand}" />
                                </StackPanel>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gửi thử gói tin" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="Gửi" Width="70" Margin="6,0,0,0"
                                        Style="{StaticResource OutlineButton}" Command="{Binding SendTestCommand}" />
                                </Grid>

                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource VsMutedBrush}"
                                       Text="Thay đổi cấu hình chỉ có hiệu lực ở lần kết nối kế tiếp. Nhớ bấm Lưu để giữ lại sau khi tắt phần mềm." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
