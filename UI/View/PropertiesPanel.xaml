<UserControl x:Class="UI.View.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="{StaticResource VsPanelBrush}">
            <DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
                    <TextBlock Text="Thuộc tính" />
                </Border>

                <!-- Mô tả của tham số đang chọn (như ô mô tả ở dưới cửa sổ Properties của Visual Studio) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource VsPanelHeaderBrush}"
                    BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Mô tả" FontWeight="SemiBold" />
                        <TextBlock Text="Chọn một node trong đồ thị để xem và chỉnh tham số."
                               Foreground="{StaticResource VsMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <!-- Tên node đang chọn -->
                        <TextBlock Text="Threshold" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Loại: Pure (không giữ trạng thái)" Foreground="{StaticResource VsMutedBrush}"
                               Margin="0,2,0,10" />

                        <!-- Nhóm: Tham số -->
                        <TextBlock Text="THAM SỐ" Foreground="{StaticResource VsAccentBrush}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Min" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="0" Margin="0,2" />

                            <TextBlock Grid.Row="1" Text="Max" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="128" Margin="0,2" />
                        </Grid>

                        <!-- Nhóm: Thông tin chung -->
                        <TextBlock Text="CHUNG" Foreground="{StaticResource VsAccentBrush}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Id" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,2" />

                            <TextBlock Grid.Row="1" Text="Trạng thái" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="Chưa chạy" Margin="0,2" />

                            <TextBlock Grid.Row="2" Text="Thời gian" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
