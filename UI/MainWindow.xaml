<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="https://miroiu.github.io/nodify" 
        mc:Ignorable="d"
        Title="Vision Tool Editor - Visual Studio Style"
        Style="{StaticResource VsWindow}"
        xmlns:views="clr-namespace:UI.Views" 
        xmlns:viewmodels="clr-namespace:UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Height="850"
        Width="1450"
        Background="#FF2D2D30"
        Foreground="#FFCCCCCC">

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding Editor.DeleteSelectedCommand}" />
        <KeyBinding Key="F5" Command="{Binding Run.RunOnceCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding Run.StopCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ================= THANH MENU ================= -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Tệp">
                <MenuItem Header="Mới" InputGestureText="Ctrl+N" />
                <MenuItem Header="Mở..." InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="Lưu" InputGestureText="Ctrl+S" />
                <MenuItem Header="Lưu thành..." InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Thoát" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Sửa">
                <MenuItem Header="Hoàn tác" InputGestureText="Ctrl+Z" />
                <MenuItem Header="Làm lại" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Xóa node" InputGestureText="Delete" Command="{Binding Editor.DeleteSelectedCommand}" />
                <MenuItem Header="Chọn tất cả" InputGestureText="Ctrl+A" />
            </MenuItem>
            <MenuItem Header="_Xem">
                <MenuItem Header="Toolbox" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="Thuộc tính" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="Ảnh gốc" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="Ảnh xử lý" IsCheckable="True" IsChecked="True" />
                <Separator />
                <MenuItem Header="Output" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="Kết nối" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="Kết quả" IsCheckable="True" IsChecked="True" />
                <Separator />
                <MenuItem Header="Đặt lại bố cục" />
            </MenuItem>
            <MenuItem Header="_Dự án">
                <MenuItem Header="Công thức (Recipe)..." />
                <MenuItem Header="Hiệu chuẩn camera - robot (từ CSV)..." Command="{Binding CalibrateFromCsvCommand}" />
                <MenuItem Header="Thư mục ảnh mẫu..." />
            </MenuItem>
            <MenuItem Header="_Chạy">
                <MenuItem Header="Chạy một lần" InputGestureText="F5" Command="{Binding Run.RunOnceCommand}" />
                <MenuItem Header="Học mẫu" Command="{Binding Run.TeachCommand}" />
                <MenuItem Header="Chạy liên tục" InputGestureText="Ctrl+F5" />
                <MenuItem Header="Dừng" InputGestureText="Shift+F5" Command="{Binding Run.StopCommand}" />
                <Separator />
                <MenuItem Header="Chế độ">
                    <MenuItem Header="Chạy thử (không điều khiển thiết bị)" IsCheckable="True" IsChecked="{Binding Run.IsDryRun, Mode=TwoWay}" />
                    <MenuItem Header="Chạy thật" IsCheckable="True" IsChecked="{Binding Run.IsLive, Mode=TwoWay}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Kết nối">
                <MenuItem Header="Kết nối tất cả" Command="{Binding Devices.ConnectAllCommand}" />
                <MenuItem Header="Ngắt tất cả" Command="{Binding Devices.DisconnectAllCommand}" />
                <Separator />
                <MenuItem Header="Cấu hình thiết bị..." Click="OpenDeviceConfig_Click" />
            </MenuItem>
            <MenuItem Header="C_ông cụ">
                <MenuItem Header="Tùy chọn..." />
            </MenuItem>
            <MenuItem Header="_Trợ giúp">
                <MenuItem Header="Giới thiệu" />
            </MenuItem>
        </Menu>

        <!-- ================= THANH CÔNG CỤ ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource VsPanelHeaderBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="4,3">
                <Button Content="Mới" />
                <Button Content="Mở" />
                <Button Content="Lưu" />
                <Rectangle Width="1" Fill="{StaticResource VsBorderBrush}" Margin="6,2" />

                <Button Content="Hoàn tác" />
                <Button Content="Làm lại" />
                <Rectangle Width="1" Fill="{StaticResource VsBorderBrush}" Margin="6,2" />

                <Button Content="&#9654; Chạy một lần" Command="{Binding Run.RunOnceCommand}" />
                <Button Content="Học mẫu" Command="{Binding Run.TeachCommand}" />
                <Button Content="&#10227; Chạy liên tục" />
                <Button Content="&#9632; Dừng" Command="{Binding Run.StopCommand}" />
                <Rectangle Width="1" Fill="{StaticResource VsBorderBrush}" Margin="6,2" />

                <TextBlock Text="Chế độ:" VerticalAlignment="Center" Margin="4,0,4,0"
                           Foreground="{StaticResource VsMutedBrush}" />
                <ToggleButton Content="Chạy thử" IsChecked="{Binding Run.IsDryRun, Mode=TwoWay}" />
                <ToggleButton Content="Chạy thật" Style="{StaticResource LiveToggle}" IsChecked="{Binding Run.IsLive, Mode=TwoWay}" />
                <Rectangle Width="1" Fill="{StaticResource VsBorderBrush}" Margin="6,2" />

                <Button Content="Vừa khung" />
            </StackPanel>
        </Border>

        <!-- ================= THANH TRẠNG THÁI ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource VsAccentBrush}" Padding="10,3">
            <DockPanel TextElement.Foreground="White">

                <!-- Tình trạng từng kết nối -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Devices.Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#9D9D9D"
                                             Stroke="White" StrokeThickness="1" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="#3FB950" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Sửa lỗi bindingDataContext bên trong ItemsControl bằng cách gọi qua MainViewModel trực tiếp -->
                    <TextBlock Text="{Binding Run.ModeText}" Margin="20,0,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding Run.StatusText}" />
            </DockPanel>
        </Border>

        <!-- ================= VÙNG LÀM VIỆC ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="420" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Toolbox (trên) và Thuộc tính (dưới) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="120" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="2*" MinHeight="120" />
                </Grid.RowDefinitions>
                <views:ToolboxPanel Grid.Row="0" />
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
                <views:PropertiesPanel Grid.Row="2" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- Cột giữa: đồ thị (trên) và các tab Output / Kết nối / Kết quả (dưới) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="250" MinHeight="80" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0">
                    <TabItem Header="Graph1.vgraph">
                        <views:GraphEditorView />
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />

                <TabControl Grid.Row="2">
                    <TabItem Header="Output">
                        <TextBox IsReadOnly="True" BorderThickness="0" Background="{StaticResource VsWindowBrush}"
                                 FontFamily="Consolas" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Text="{Binding Run.OutputText, Mode=OneWay}"
                                 TextChanged="OutputBox_TextChanged" />
                    </TabItem>

                    <TabItem Header="Kết nối">
                        <views:ConnectionsPanel />
                    </TabItem>

                    <TabItem Header="Kết quả">
                        <Grid Background="{StaticResource VsWindowBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề cột bảng kết quả -->
                            <Border Background="{StaticResource VsPanelHeaderBrush}"
                                    BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Node" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Trạng thái" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Thời gian" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Thông điệp" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Run.Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding NodeName}" />
                                                <TextBlock Grid.Column="1" x:Name="Status" Text="{Binding StatusText}" Foreground="#3FB950" />
                                                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Details}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Details}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOk}" Value="False">
                                                    <Setter TargetName="Status" Property="Foreground" Value="#F85149" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Grid.Row="1" Text="Chưa có kết quả. Nhấn Chạy để thực thi đồ thị."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Run.HasResults}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />

            <!-- Cột phải: ảnh gốc (trên) và ảnh đã xử lý (dưới) -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>
                <views:ImageViewerPanel Grid.Row="0" Title="Ảnh gốc" Display="{Binding Run.Original}"
                                        Roi="{Binding Roi.Current}" RoiChangedCommand="{Binding Roi.ApplyCommand}" />
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
                <views:ImageViewerPanel Grid.Row="2" Title="Ảnh xử lý" Display="{Binding Run.Processed}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>